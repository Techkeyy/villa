{
  "name": "villa",
  "version": "0.0.1",
  "private": true,
  "description": "VILLA — autonomous liquidity manager for DreamDEX Event Contracts",
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "start": "node scripts/dashboard-server.mjs --replay",
    "discover": "node scripts/discover.mjs",
    "test": "node --test scripts/lib/write-path.test.mjs src/account/*.test.mjs src/fair-value/*.test.mjs src/risk-governor/*.test.mjs src/quote-planner/*.test.mjs src/inventory-lifecycle/*.test.mjs src/execution/*.test.mjs src/settlement/*.test.mjs src/dashboard/*.test.mjs src/rollover/*.test.mjs src/orchestrator/*.test.mjs",
    "dashboard:dev": "node scripts/dashboard-server.mjs --replay",
    "dashboard:live": "node --env-file=.env scripts/dashboard-server.mjs --live",
    "dashboard:replay": "node scripts/dashboard-server.mjs --replay",
    "operator:dev": "node --env-file=.env scripts/operator-api.mjs",
    "operator:test": "node --test src/operator/*.test.mjs",
    "phase3a:readonly": "node scripts/phase3a-readonly.mjs",
    "phase3b0:test": "node --test src/execution/lp-*.test.mjs",
    "phase3b1a:test": "node --test src/execution/lp-*.test.mjs",
    "phase3b1a:one-cycle": "node scripts/lp-one-cycle.mjs --one-cycle --account=0x1111111111111111111111111111111111111111 --session-id=local-shadow-smoke",
    "phase3b1a:feasibility": "node scripts/phase3b1a-feasibility-readonly.mjs",
    "phase3b1a4:calibrate": "node scripts/phase3b1a4-capital-calibration-readonly.mjs",
    "phase3b1a5:topup-plan": "node scripts/phase3b1a5-owner-topup-prep.mjs",
    "phase3b1a:owner-prep": "node scripts/phase3b1a-owner-prep.mjs",
    "phase3b1b1:owner-prep": "node scripts/phase3b1b1-owner-prep-wizard.mjs",
    "phase3b1b2.3:redeem-cleanup": "node --env-file=.env scripts/lp-redeem-cleanup-one-shot.mjs --confirm-redeem",
    "dashboard:build": "node scripts/dashboard-build.mjs",
    "dashboard:test": "node --test src/dashboard/*.test.mjs",
    "fair-value": "node --env-file=.env scripts/fair-value-snapshot.mjs",
    "risk": "node --env-file=.env scripts/risk-snapshot.mjs",
    "quote": "node --env-file=.env scripts/quote-snapshot.mjs",
    "verify:write": "node --env-file=.env scripts/verify-write-path.mjs",
    "verify:write:dry": "node --env-file=.env scripts/verify-write-path.mjs --dry-run",
    "verify:inventory": "node --env-file=.env scripts/verify-inventory-lifecycle.mjs",
    "verify:inventory:dry": "node --env-file=.env scripts/verify-inventory-lifecycle.mjs --dry-run",
    "verify:quote-cycle": "node --env-file=.env scripts/verify-quote-cycle.mjs",
    "verify:quote-cycle:dry": "node --env-file=.env scripts/verify-quote-cycle.mjs --dry-run",
    "verify:settlement": "node --env-file=.env scripts/verify-settlement.mjs --confirm",
    "verify:settlement:dry": "node --env-file=.env scripts/verify-settlement.mjs --dry-run",
    "verify:organic-redeem": "node --env-file=.env scripts/redeem-organic-fills.mjs --confirm",
    "verify:organic-redeem:dry": "node --env-file=.env scripts/redeem-organic-fills.mjs --dry-run",
    "verify:wallet-hygiene": "node --env-file=.env scripts/wallet-hygiene-audit.mjs --confirm",
    "verify:wallet-hygiene:dry": "node --env-file=.env scripts/wallet-hygiene-audit.mjs --dry-run",
    "verify:rollover": "node --env-file=.env scripts/verify-rollover.mjs",
    "villa:bounded:dry": "node --env-file=.env scripts/villa-bounded.mjs --dry-run",
    "villa:bounded": "node --env-file=.env scripts/villa-bounded.mjs --confirm",
    "fund:tusdc": "node --env-file=.env scripts/fund-tusdc.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.28.1",
    "viem": "^2.55.19"
  }
}
