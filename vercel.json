{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run dashboard:build",
  "outputDirectory": "dist/dashboard",
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/proof", "destination": "/proof/index.html" },
    { "source": "/proof/", "destination": "/proof/index.html" }
  ]
}
